/* The Options screen (options.rml). 1dp = one pixel of the game's 640x480
   menus. Made by tools/mcm2rml.py, then edited by hand. Pictures:
   /dat/<ARCHIVE>/<file> is the game's own (UI\<ARCHIVE>.DAT); options after
   '?': black (black is see-through too), opaque, frame=N (only the outer N
   pixels), bar (a slider track without its tick marks). */

body, div, span, p { display: block; }
span { display: inline; }
body {
  width: 100%;
  height: 100%;
  background-color: #000000;
  font-family: Arial;
  font-weight: bold;
  font-size: 13dp;
  line-height: 15dp;
  color: #ffffff;
  font-effect: shadow(1dp 1dp #000000);
  white-space: nowrap;
}
/* The 640x480 menu area in the middle of the window. */
#screen {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 640dp;
  height: 480dp;
  margin-left: -320dp;
  margin-top: -240dp;
  decorator: image(/dat/OPTBASE/Options/OptionsBackGround.tga?opaque);
}
#screen div, #screen input, #screen select { position: absolute; box-sizing: border-box; }
#screen span { position: static; }
.page { left: 20dp; top: 35dp; width: 600dp; height: 360dp; }
.game-hidden { display: none; }

/* Everything that can be picked: arrows / d-pad move, Enter / A clicks. */
.tab, .button, .check, .radio, .cycle, .slider, .dropdown { tab-index: auto; nav: auto; focus: auto; }
.disabled { tab-index: none; nav: none; focus: none; }

/* Box plates on MCM2MaX's own layouts: the edge of a game plate only. */
@spritesheet plate {
  src: /dat/OPTGRAPH/Options/Graphics/GPlate03.tga?frame=2;
  plate-outer: 0px 0px 228px 123px;
  plate-inner: 2px 2px 224px 119px;
}

/* Tabs: the picked one is lit (.on). */
.tab { text-align: center; }

/* Checkboxes and radio buttons: the box, then the text. */
.check .box, .radio .box { left: 0; top: 0; width: 14dp; height: 18dp; }
.radio .box { height: 14dp; }
.check .box { decorator: image(/dat/GLOBAL/Rev2GlobalSource/CheckBoxOff.tga); }
.check.on .box { decorator: image(/dat/GLOBAL/Rev2GlobalSource/CheckBoxOn.tga); }
.check.disabled .box { decorator: image(/dat/GLOBAL/Rev2GlobalSource/CheckBoxOffGrey.tga); }
.check.on.disabled .box { decorator: image(/dat/GLOBAL/Rev2GlobalSource/CheckBoxOnGrey.tga); }
.radio .box { decorator: image(/dat/GLOBAL/Resources/RadioButtonOff.tga); }
.radio.on .box { decorator: image(/dat/GLOBAL/Resources/RadioButtonOn.tga); }
.radio.disabled .box { decorator: image(/dat/GLOBAL/Resources/RadioButtonOffGrey.tga); }
.radio.on.disabled .box { decorator: image(/dat/GLOBAL/Resources/RadioButtonOnGrey.tga); }
.disabled { color: #8c8c8c; }

/* A setting that steps through its choices (Chat Box Mode). */
.cycle { text-align: center; }

/* Sliders: the track and its thumb (each slider's own pictures below). */
.slider slidertrack { height: 100%; }
.slider sliderarrowdec, .slider sliderarrowinc { width: 0; height: 0; }

/* Dropdowns: the text box, the arrow, the list. */
.dropdown { text-align: left; }
.dropdown selectvalue { display: block; width: auto; margin-right: 21dp; height: 18dp; padding: 3dp 4dp 0 4dp; decorator: image(/dat/OPTGRAPH/Options/Graphics/DropDown05.tga); }
.dropdown selectarrow { display: block; width: 21dp; height: 21dp; decorator: image(/dat/GLOBAL/Resources/DownArrowUp.tga); }
.dropdown:hover selectarrow, .dropdown:focus-visible selectarrow { decorator: image(/dat/GLOBAL/Resources/DownArrowLit.tga); }
.dropdown selectarrow:active { decorator: image(/dat/GLOBAL/Resources/DownArrowDown.tga); }
.dropdown selectbox {
  margin-top: 0;
  max-height: 200dp;
  overflow-y: auto;
  background-color: #10183a;
  border: 1dp #5a6290;
}
.dropdown selectbox option { padding: 0 4dp; height: 16dp; line-height: 16dp; }
.dropdown selectbox option:hover, .dropdown selectbox option:checked { background-color: #3a4a8c; color: #ffffff; }
.dropdown selectbox scrollbarvertical { width: 21dp; decorator: image(/dat/OPTGRAPH/Options/Graphics/VerticleScroll04.tga); }
.dropdown selectbox scrollbarvertical sliderbar { width: 17dp; margin-left: 2dp; decorator: image(/dat/GLOBAL/Resources/ElevatorThumbUp.tga); }
.dropdown selectbox scrollbarvertical sliderarrowdec, .dropdown selectbox scrollbarvertical sliderarrowinc { width: 0; height: 0; }

/* ---- each control's own pictures (from the game's layouts) ---- */
#GameSettings { decorator: image(/dat/OPTBASE/Options/OptTabDown01.tga?black); }
#GameSettings.on { decorator: image(/dat/OPTBASE/Options/OptTab01.tga?black); }
#Graphics { decorator: image(/dat/OPTBASE/Options/OptTabDown02.tga?black); }
#Graphics.on { decorator: image(/dat/OPTBASE/Options/OptTab02.tga?black); }
#Sound { decorator: image(/dat/OPTBASE/Options/OptTabDown03.tga?black); }
#Sound.on { decorator: image(/dat/OPTBASE/Options/OptTab03.tga?black); }
#Controls { decorator: image(/dat/OPTBASE/Options/OptTabDown04.tga?black); }
#Controls.on { decorator: image(/dat/OPTBASE/Options/OptTab04.tga?black); }
#Messages { decorator: image(/dat/OPTBASE/Options/OptTabDown05.tga?black); }
#Messages.on { decorator: image(/dat/OPTBASE/Options/OptTab05.tga?black); }
#Garage { decorator: image(/dat/OPTBASE/Options/OptTabDown06.tga?black); }
#Garage.on { decorator: image(/dat/OPTBASE/Options/OptTab06.tga?black); }
#Back { decorator: image(/dat/GLOBAL/Rev2GlobalSource/R2BackUp.tga); }
#Back:hover, #Back:focus-visible { decorator: image(/dat/GLOBAL/Rev2GlobalSource/R2BackLit.tga); }
#Back:active { decorator: image(/dat/GLOBAL/Rev2GlobalSource/R2BackDown.tga); }
#Help { decorator: image(/dat/GLOBAL/Rev2GlobalSource/R2HelpUp.tga); }
#Help:hover, #Help:focus-visible { decorator: image(/dat/GLOBAL/Rev2GlobalSource/R2HelpLit.tga); }
#Help:active { decorator: image(/dat/GLOBAL/Rev2GlobalSource/R2HelpDown.tga); }
#Advanced { decorator: image(/dat/OPTBASE/Options/AdvancedButtonUp.tga); }
#Advanced:active { decorator: image(/dat/OPTBASE/Options/AdvancedButtonDown.tga); }
#Restore { decorator: image(/dat/OPTBASE/Options/DefaultButtonUp.tga); }
#Restore:active { decorator: image(/dat/OPTBASE/Options/DefaultButtonDown.tga); }
#OverlaysBox { decorator: image(/dat/OPTGAME/Options/GameSettings/GSPlate02.tga); }
#rbwFrame1 { decorator: image(/dat/OPTGAME/Options/GameSettings/GSEntrybox.tga); }
#MiscSettingsBox { decorator: image(/dat/OPTGAME/Options/GameSettings/GSPlate01.tga); }
#DisplayResolutionBox { decorator: ninepatch(plate-outer, plate-inner, 1); }
#TerrainQualityBox { decorator: ninepatch(plate-outer, plate-inner, 1); }
#TerrainQualitySliderBar slidertrack { decorator: image(/dat/OPTGRAPH/Options/Graphics/GHorizontalSlider01.tga); }
#TerrainQualitySliderBar sliderbar { width: 8dp; height: 15dp; margin-top: 0dp; decorator: image(/dat/OPTGRAPH/Options/Graphics/GSmallHSliderUp.tga); }
#GraphicFeaturesBox { decorator: ninepatch(plate-outer, plate-inner, 1); }
#Mcm2fixBox { decorator: ninepatch(plate-outer, plate-inner, 1); }
#Mcm2fixAniso slidertrack { decorator: image(/dat/OPTGRAPH/Options/Graphics/GHorizontalSlider01.tga?bar); }
#Mcm2fixAniso sliderbar { width: 8dp; height: 15dp; margin-top: 0dp; decorator: image(/dat/OPTGRAPH/Options/Graphics/GSmallHSliderUp.tga); }
#Mcm2fixMsaa slidertrack { decorator: image(/dat/OPTGRAPH/Options/Graphics/GHorizontalSlider01.tga?bar); }
#Mcm2fixMsaa sliderbar { width: 8dp; height: 15dp; margin-top: 0dp; decorator: image(/dat/OPTGRAPH/Options/Graphics/GSmallHSliderUp.tga); }
#Mcm2fixView slidertrack { decorator: image(/dat/OPTGRAPH/Options/Graphics/GHorizontalSlider01.tga?bar); }
#Mcm2fixView sliderbar { width: 8dp; height: 15dp; margin-top: 0dp; decorator: image(/dat/OPTGRAPH/Options/Graphics/GSmallHSliderUp.tga); }
#Mcm2fixMaX { decorator: image(/dat/OPTGRAPH/Options/Graphics/AdvancedBttnUp.tga); }
#Mcm2fixMaX:active { decorator: image(/dat/OPTGRAPH/Options/Graphics/AdvancedBttnDown.tga); }
#SoundSettingsBox { decorator: image(/dat/OPTSOUND/Options/Sound/SPlate01.tga); }
#VolumeSettingsBox { decorator: image(/dat/OPTSOUND/Options/Sound/SPlate02.tga); }
#UserInterfaceVolumeSlider slidertrack { decorator: image(/dat/OPTSOUND/Options/Sound/SHorizontalSlider01.tga); }
#UserInterfaceVolumeSlider sliderbar { width: 8dp; height: 15dp; margin-top: 0dp; decorator: image(/dat/OPTSOUND/Options/Sound/SSmallHSliderUp.tga); }
#InGameVolumeSlider slidertrack { decorator: image(/dat/OPTSOUND/Options/Sound/SHorizontalSlider01.tga); }
#InGameVolumeSlider sliderbar { width: 8dp; height: 15dp; margin-top: 0dp; decorator: image(/dat/OPTSOUND/Options/Sound/SSmallHSliderUp.tga); }
