/* mainmenu.rml: each control's own pictures (from the game's layouts). Made by tools/mcm2rml.py. */
#mainmenu-MenuSingleAnimation { decorator: image(/dat/GLOBAL/01_Main/SinglePullDown0015.tga); }
#mainmenu-ScreenOverCtl { decorator: image(/dat/MAINMENU/01_Main/screenover.tga); }
#mainmenu-MenuSingle { decorator: image(/dat/MAINMENU/01_Main/SingleUp.tga); }
