#mainmenu-MenuSingle:active { decorator: image(/dat/MAINMENU/01_Main/SingleDown.tga); }
#mainmenu-MenuSingle.disabled { decorator: image(/dat/MAINMENU/01_Main/SingleGrey.tga); }
